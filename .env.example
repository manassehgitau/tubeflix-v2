# TMDB (The Movie Database) API Configuration
# Get your API credentials at https://www.themoviedb.org/settings/api

# TMDB API Base URL
# This is the base URL for making API requests to TMDB
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB API Read Access Token (v4 auth)
# Generate this token from your TMDB account settings
# This is used for authentication in API requests
VITE_TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# TMDB Image Base Path
# This is the base URL for loading images from TMDB
# Common values: https://image.tmdb.org/t/p/original or https://image.tmdb.org/t/p/w500
VITE_TMDB_IMAGE_BASE_PATH=https://image.tmdb.org/t/p/original
